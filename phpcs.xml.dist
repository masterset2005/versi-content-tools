<?xml version="1.0"?>
<ruleset name="versi-content-tools">
	<description>PHPCS config for Versi Content Tools</description>

	<rule ref="WordPress">
		<!-- Short descriptive filenames (class-admin.php etc.) are intentional -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName" />
		<!-- Plugin slug on wp.org is 'versi-content-tools'; folder name may differ -->
		<exclude name="WordPress.WP.I18n.TextDomainMismatch" />
	</rule>

	<config name="minimum_wp_version" value="7.0" />
	<config name="text_domain" value="versi-content-tools,default" />

	<arg name="extensions" value="php" />

	<file>.</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/.git/*</exclude-pattern>

	<rule ref="WordPress.DB.SlowDBQuery">
		<exclude name="WordPress.DB.SlowDBQuery.slow_db_query_meta_key" />
		<exclude name="WordPress.DB.SlowDBQuery.slow_db_query_meta_query" />
		<exclude name="WordPress.DB.SlowDBQuery.slow_db_query_tax_query" />
	</rule>

	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<!-- Stats queries use custom SQL for performance; caching is acceptable here -->
		<exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery" />
		<exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching" />
	</rule>

	<rule ref="WordPress.Security.NonceVerification">
		<!--
			Read-only $_GET access for UI display context (settings/processing pages).
			AJAX handlers use check_ajax_referer() via ajax_check() but PHPCS cannot
			trace the nonce check through the helper method.
		-->
		<exclude name="WordPress.Security.NonceVerification.Recommended" />
		<exclude name="WordPress.Security.NonceVerification.Missing" />
	</rule>

	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<!-- WordPress action/filter hook signatures often include unused params -->
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.FoundAfterLastUsed" />
	</rule>
</ruleset>
